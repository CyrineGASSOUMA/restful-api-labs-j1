{
  "name": "Formation RESTful API - Jour 1",
  "image": "mcr.microsoft.com/devcontainers/java:1-21",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "none", "installMaven": "true" }
  },
  "hostRequirements": { "cpus": 2 },
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "API banque", "onAutoForward": "notify" } },
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-spring-boot", "humao.rest-client"]
    }
  },
  "postCreateCommand": "cd labs/banque-api && mvn -q -DskipTests dependency:go-offline"
}
